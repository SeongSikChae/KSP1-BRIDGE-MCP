<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Local machine paths (KspDir, AppDir); not committed. -p:Name=value on the command line still wins. -->
  <Import Project="$(MSBuildThisFileDirectory)KspBridge.user.props" Condition="Exists('$(MSBuildThisFileDirectory)KspBridge.user.props')" />

</Project>
