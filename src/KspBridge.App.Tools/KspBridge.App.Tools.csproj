<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loaded by the App shell into a collectible AssemblyLoadContext and replaced at runtime with reload_app.
       Core and the MCP SDK come from the shell's default context, so they are not copied next to this DLL. -->

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KspBridge.App.Core\KspBridge.App.Core.csproj" Private="false" />
  </ItemGroup>

  <Target Name="DeployToApp" AfterTargets="Build" Condition="'$(AppDir)'!=''">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AppDir)\Tools" />
  </Target>

</Project>
