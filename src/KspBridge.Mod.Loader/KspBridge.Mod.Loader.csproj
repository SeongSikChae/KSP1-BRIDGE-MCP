<Project Sdk="Microsoft.NET.Sdk">

  <!-- KSP 1.12.5 runs on Unity 2019.4 Mono: the plugin must target .NET Framework 4.7.2 (exception to the net10.0 default). -->
  <!-- Fixed host: loaded once by KSP from GameData/KspBridge/Plugins. Changing it needs a KSP restart. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>KspBridge.Mod.Loader</RootNamespace>
    <KspManaged>$(KspDir)\KSP_x64_Data\Managed</KspManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Protocol.cs" Link="Shared\Protocol.cs" />
    <None Include="settings.cfg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
