<Project Sdk="Microsoft.NET.Sdk">

  <!-- KSP 1.12.5 runs on Unity 2019.4 Mono: the plugin must target .NET Framework 4.7.2 (exception to the net10.0 default). -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>KspBridge</RootNamespace>
    <AssemblyName>KspBridge.Mod</AssemblyName>
    <KspManaged>$(KspDir)\KSP_x64_Data\Managed</KspManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(KspManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(KspManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(KspManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(KspManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="settings.cfg" />
  </ItemGroup>

  <Target Name="CheckKspDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(KspDir)'=='' Or !Exists('$(KspManaged)')" Text="KSP install path not found (KspDir='$(KspDir)'). Set KspDir in KspBridge.user.props at the repository root or pass -p:KspDir=&quot;&lt;KSP folder&gt;&quot;." />
  </Target>

  <Target Name="DeployToKsp" AfterTargets="Build" Condition="Exists('$(KspDir)\GameData')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(KspDir)\GameData\KspBridge\Plugins" />
    <Copy SourceFiles="settings.cfg" DestinationFolder="$(KspDir)\GameData\KspBridge" />
  </Target>

</Project>
